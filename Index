<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Copiloto Clínico Multiabordagem</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- html2pdf.js CDN para Geração de PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 pb-24 antialiased min-h-screen">

    <!-- Top Header Azul -->
    <header class="bg-indigo-600 text-white text-center py-4 px-3 shadow-md sticky top-0 z-30">
        <h1 class="text-xl font-bold flex items-center justify-center gap-2">
            🧠 Copiloto Clínico Multiabordagem
        </h1>
        <p class="text-xs text-indigo-100 font-medium mt-0.5">Supervisão TCC, Psicanálise, Humanista e Behaviorista</p>
    </header>

    <main class="max-w-md mx-auto p-4 space-y-4">

        <!-- Aviso Ético -->
        <div class="bg-red-50 border border-red-200 rounded-xl p-3.5 text-xs text-red-700 leading-relaxed shadow-sm">
            <span class="font-bold">🔒 Aviso Ético de Testes:</span> Protótipo local para validação. Não insira dados sensíveis ou nomes completos reais de pacientes.
        </div>

        <!-- ABA 1: HOME -->
        <section id="tab-home" class="tab-content space-y-4">
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80">
                <div class="flex items-center gap-2 mb-3 border-b border-slate-100 pb-2">
                    <span class="text-lg">💬</span>
                    <h2 class="text-base font-bold text-indigo-700">Análise do Caso Completo</h2>
                </div>
                
                <div class="space-y-3">
                    <label class="block text-xs font-semibold text-slate-600">Selecione o Paciente:</label>
                    <select id="home-paciente-select" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">-- Selecione um Paciente --</option>
                    </select>

                    <button onclick="irParaSupervisorComPaciente('home-paciente-select')" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm transition flex items-center justify-center gap-2 shadow">
                        ⚡ Analisar Histórico no Supervisor
                    </button>
                </div>
            </div>

            <!-- HISTÓRICO COMPLETO DE SESSÕES -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80">
                <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">📚</span>
                        <h2 class="text-base font-bold text-indigo-700">Histórico de Sessões</h2>
                    </div>
                    <span id="home-historico-qtd" class="text-[10px] bg-indigo-100 text-indigo-700 font-bold px-2 py-0.5 rounded-full">0</span>
                </div>

                <!-- Filtro por Paciente -->
                <div class="mb-3">
                    <select id="home-filtro-paciente" onchange="atualizarHistoricoHome()" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-600 focus:outline-none">
                        <option value="">Filtrar por todos os pacientes</option>
                    </select>
                </div>

                <div id="home-historico-lista" class="space-y-3 text-xs text-slate-500">
                    <!-- Preenchido via JS -->
                </div>
            </div>
        </section>

        <!-- ABA 2: PACIENTES -->
        <section id="tab-pacientes" class="tab-content hidden space-y-4">
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80 space-y-3">
                <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
                    <span class="text-lg">👤</span>
                    <h2 class="text-base font-bold text-indigo-700">Cadastro de Paciente</h2>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Código/Iniciais:</label>
                    <input type="text" id="paciente-nome" placeholder="Ex: Paciente B" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Abordagem Teórica Predominante:</label>
                    <select id="paciente-abordagem" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="tcc">Terapia Cognitivo-Comportamental (TCC)</option>
                        <option value="psicanalise">Psicanálise / Psicodinâmica</option>
                        <option value="humanista">Humanista / Fenomenológica / ACP</option>
                        <option value="behaviorista">Análise do Comportamento (Behaviorismo)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Queixa Principal:</label>
                    <textarea id="paciente-queixa" rows="2" placeholder="Ex: Dificuldade em estabelecer limites interpessoais..." class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Objetivo Terapêutico:</label>
                    <input type="text" id="paciente-objetivo" placeholder="Ex: Desenvolvimento de autonomia e regulação emocional" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <button onclick="salvarNovoPaciente()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm shadow transition">
                    Salvar Paciente
                </button>
            </div>

            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80">
                <div class="flex items-center gap-2 mb-3 border-b border-slate-100 pb-2">
                    <span class="text-lg">👥</span>
                    <h2 class="text-base font-bold text-indigo-700">Pacientes Cadastrados</h2>
                </div>
                <div id="lista-pacientes-cadastrados" class="space-y-3">
                    <!-- Preenchido via JS -->
                </div>
            </div>
        </section>

        <!-- ABA 3: SESSÃO -->
        <section id="tab-sessao" class="tab-content hidden space-y-4">
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80 space-y-3">
                <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
                    <span class="text-lg">📝</span>
                    <h2 class="text-base font-bold text-indigo-700">Registrar Nova Sessão</h2>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Paciente:</label>
                    <select id="sessao-paciente-select" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">-- Selecione um Paciente --</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Data da Sessão:</label>
                    <input type="text" id="sessao-data" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Relato da Sessão / Observações:</label>
                    <textarea id="sessao-relato" rows="4" placeholder="Descreva os relatos, falas marcantes, afetos demonstrados, reações do terapeuta e intervenções realizadas..." class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-y"></textarea>
                </div>

                <button onclick="salvarRegistroSessao()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm shadow transition">
                    Salvar Registro de Sessão
                </button>
            </div>
        </section>

        <!-- ABA 4: SUPERVISOR -->
        <section id="tab-supervisor" class="tab-content hidden space-y-4">
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80 space-y-3">
                <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
                    <span class="text-lg">🏫</span>
                    <h2 class="text-base font-bold text-indigo-700">Painel do Supervisor</h2>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Paciente Ativo:</label>
                    <select id="supervisor-paciente-select" onchange="carregarContextoGlobalParaSupervisor()" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">-- Selecione um Paciente --</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Abordagem para Análise:</label>
                    <select id="supervisor-abordagem-select" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-semibold text-indigo-900">
                        <option value="tcc">Terapia Cognitivo-Comportamental (TCC)</option>
                        <option value="psicanalise">Psicanálise / Psicodinâmica</option>
                        <option value="humanista">Humanista / Fenomenológica / ACP</option>
                        <option value="behaviorista">Análise do Comportamento (Behaviorismo)</option>
                    </select>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-semibold text-slate-600">Histórico Mapeado para Análise:</label>
                        <button onclick="carregarContextoGlobalParaSupervisor()" class="text-[10px] text-indigo-600 font-semibold hover:underline">🔄 Recarregar Histórico</button>
                    </div>
                    <textarea id="supervisor-relato-input" rows="6" placeholder="Selecione um paciente para carregar o histórico de sessões..." class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-y font-mono"></textarea>
                </div>

                <button onclick="executarSupervisaoClínica()" id="btn-analisar" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm shadow transition flex items-center justify-center gap-2">
                    ⚡ Gerar Análise Teórica & Orientação Clínica
                </button>
            </div>

            <!-- Loading -->
            <div id="supervisor-loading" class="hidden text-center py-6 space-y-2">
                <div class="inline-block animate-spin rounded-full h-7 w-7 border-3 border-indigo-600 border-t-transparent"></div>
                <p class="text-xs text-slate-600 font-medium">Analisando o caso sob a abordagem selecionada...</p>
            </div>

            <!-- Caixa de Detalhes de Erro -->
            <div id="supervisor-erro-box" class="hidden bg-red-100 border border-red-300 text-red-800 rounded-2xl p-4 text-xs space-y-2">
                <p class="font-bold flex items-center gap-1 text-sm text-red-900">⚠️ Erro na Requisição:</p>
                <div id="supervisor-erro-detalhe" class="font-mono bg-white p-2.5 rounded border border-red-200 overflow-x-auto text-[11px] leading-tight"></div>
            </div>

            <!-- Resultado & Exportação em PDF -->
            <div id="supervisor-resultado" class="hidden space-y-3">
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-3">
                    <div class="flex items-center justify-between border-b pb-2">
                        <h3 class="text-sm font-bold text-indigo-700 flex items-center gap-1.5">
                            📑 Formulação Clínica & Direcionamento
                        </h3>
                    </div>

                    <div id="supervisor-resposta-conteudo" class="text-xs text-slate-700 leading-relaxed space-y-3">
                        <!-- Resposta da IA -->
                    </div>
                </div>

                <!-- Botão de Download PDF -->
                <button onclick="gerarPDFRelatorio()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow-md transition flex items-center justify-center gap-2">
                    📄 Exportar Relatório Clínico Completo em PDF
                </button>
            </div>
        </section>

    </main>

    <!-- TEMPLATE OCULTO PARA IMPRESSÃO EM PDF -->
    <div class="hidden">
        <div id="pdf-template" class="p-8 bg-white text-slate-900 space-y-6 font-sans">
            <!-- Cabeçalho do Documento -->
            <div class="border-b-2 border-indigo-600 pb-4 flex justify-between items-end">
                <div>
                    <h1 class="text-xl font-bold text-indigo-900">PRONTUÁRIO & RELATÓRIO DE SUPERVISÃO CLÍNICA</h1>
                    <p class="text-xs text-slate-500 font-medium">Copiloto Clínico Multiabordagem</p>
                </div>
                <div class="text-right text-xs text-slate-500">
                    <p id="pdf-data-emissao"></p>
                </div>
            </div>

            <!-- Dados do Paciente -->
            <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 text-xs space-y-1.5">
                <h3 class="font-bold text-indigo-800 text-sm border-b border-slate-200 pb-1 mb-2">1. DADOS DE IDENTIFICAÇÃO DO CASO</h3>
                <p><strong>Paciente/Código:</strong> <span id="pdf-paciente-nome"></span></p>
                <p><strong>Abordagem Teórica Utilizada:</strong> <span id="pdf-abordagem-nome"></span></p>
                <p><strong>Queixa Principal:</strong> <span id="pdf-queixa"></span></p>
                <p><strong>Objetivo Terapêutico:</strong> <span id="pdf-objetivo"></span></p>
            </div>

            <!-- Histórico Completo de Sessões Registradas -->
            <div class="space-y-2">
                <h3 class="font-bold text-indigo-800 text-sm border-b border-slate-200 pb-1">2. HISTÓRICO DAS SESSÕES DE EVOLUÇÃO</h3>
                <div id="pdf-historico-sessoes" class="space-y-3 text-xs">
                    <!-- Preenchido dinamicamente no JS -->
                </div>
            </div>

            <!-- Análise e Formulação Teórica do Supervisor -->
            <div class="space-y-2">
                <h3 class="font-bold text-indigo-800 text-sm border-b border-slate-200 pb-1">3. FORMULAÇÃO TEÓRICA & ORIENTAÇÃO DO SUPERVISOR</h3>
                <div id="pdf-conteudo-analise" class="text-xs leading-relaxed space-y-4">
                    <!-- Conteúdo do Supervisor Injetado -->
                </div>
            </div>

            <!-- Rodapé Ético -->
            <div class="border-t border-slate-200 pt-4 text-[10px] text-slate-400 text-center space-y-1">
                <p>🔒 Documento sigiloso para uso exclusivo do profissional de saúde mental em acompanhamento supervisor.</p>
                <p>Gerado via Copiloto Clínico - Software de Apoio à Decisão Terapêutica.</p>
            </div>
        </div>
    </div>

    <!-- Barra de Navegação Inferior -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 shadow-lg z-40">
        <div class="max-w-md mx-auto grid grid-cols-4 text-center py-2">
            <button onclick="mudarAba('tab-home', this)" class="nav-btn text-indigo-600 flex flex-col items-center justify-center gap-0.5">
                <span class="text-xl">🧠</span>
                <span class="text-[11px] font-medium">Home</span>
            </button>

            <button onclick="mudarAba('tab-pacientes', this)" class="nav-btn text-slate-400 flex flex-col items-center justify-center gap-0.5">
                <span class="text-xl">👤</span>
                <span class="text-[11px] font-medium">Pacientes</span>
            </button>

            <button onclick="mudarAba('tab-sessao', this)" class="nav-btn text-slate-400 flex flex-col items-center justify-center gap-0.5">
                <span class="text-xl">📝</span>
                <span class="text-[11px] font-medium">Sessão</span>
            </button>

            <button onclick="mudarAba('tab-supervisor', this)" class="nav-btn text-slate-400 flex flex-col items-center justify-center gap-0.5">
                <span class="text-xl">💬</span>
                <span class="text-[11px] font-medium">Supervisor</span>
            </button>
        </div>
    </nav>

    <script>
        document.getElementById('sessao-data').value = new Date().toLocaleDateString('pt-BR');

        document.addEventListener('DOMContentLoaded', () => {
            atualizarListasEPacientes();
        });

        function mudarAba(abaId, btnElement) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(abaId).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-indigo-600');
                btn.classList.add('text-slate-400');
            });

            if(btnElement) {
                btnElement.classList.remove('text-slate-400');
                btnElement.classList.add('text-indigo-600');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function salvarNovoPaciente() {
            const nome = document.getElementById('paciente-nome').value.trim();
            const abordagem = document.getElementById('paciente-abordagem').value;
            const queixa = document.getElementById('paciente-queixa').value.trim();
            const objetivo = document.getElementById('paciente-objetivo').value.trim();

            if (!nome) {
                alert("Insira pelo menos as iniciais ou nome do paciente.");
                return;
            }

            let pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            const novo = { id: Date.now().toString(), nome, abordagem, queixa, objetivo };
            pacientes.push(novo);
            localStorage.setItem('tcc_pacientes', JSON.stringify(pacientes));

            document.getElementById('paciente-nome').value = '';
            document.getElementById('paciente-queixa').value = '';
            document.getElementById('paciente-objetivo').value = '';

            atualizarListasEPacientes();
            alert("Paciente cadastrado com sucesso!");
        }

        function nomeAbordagemFormatada(sigla) {
            const mapa = {
                'tcc': 'Terapia Cognitivo-Comportamental (TCC)',
                'psicanalise': 'Psicanálise / Psicodinâmica',
                'humanista': 'Humanista / ACP',
                'behaviorista': 'Análise do Comportamento (Behaviorismo)'
            };
            return mapa[sigla] || 'TCC';
        }

        function atualizarListasEPacientes() {
            const pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            const s1 = document.getElementById('home-paciente-select');
            const s2 = document.getElementById('sessao-paciente-select');
            const s3 = document.getElementById('supervisor-paciente-select');
            const sFiltro = document.getElementById('home-filtro-paciente');

            const optionsHTML = '<option value="">-- Selecione um Paciente --</option>' + 
                pacientes.map(p => `<option value="${p.id}">${p.nome} (${nomeAbordagemFormatada(p.abordagem)})</option>`).join('');

            s1.innerHTML = optionsHTML;
            s2.innerHTML = optionsHTML;
            s3.innerHTML = optionsHTML;

            sFiltro.innerHTML = '<option value="">Filtrar por todos os pacientes</option>' + 
                pacientes.map(p => `<option value="${p.id}">${p.nome}</option>`).join('');

            const listaDiv = document.getElementById('lista-pacientes-cadastrados');
            if(pacientes.length === 0) {
                listaDiv.innerHTML = '<p class="text-xs text-slate-400 italic">Nenhum paciente cadastrado ainda.</p>';
            } else {
                listaDiv.innerHTML = pacientes.map(p => `
                    <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-1">
                        <div class="flex justify-between items-center">
                            <h4 class="font-bold text-sm text-slate-800">${p.nome}</h4>
                            <span class="text-[10px] bg-indigo-100 text-indigo-700 font-bold px-2 py-0.5 rounded-full">${nomeAbordagemFormatada(p.abordagem)}</span>
                        </div>
                        <p class="text-xs text-slate-600"><span class="font-semibold">Queixa:</span> ${p.queixa || 'Não informada'}</p>
                        <p class="text-xs text-slate-600"><span class="font-semibold">Objetivo:</span> ${p.objetivo || 'Não informado'}</p>
                        <div class="text-right pt-1">
                            <button onclick="excluirPaciente('${p.id}')" class="text-[10px] text-red-500 hover:text-red-700 font-semibold">Excluir Paciente</button>
                        </div>
                    </div>
                `).join('');
            }

            atualizarHistoricoHome();
        }

        function excluirPaciente(id) {
            if(!confirm("Tem certeza que deseja excluir este paciente e suas sessões?")) return;
            let pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            pacientes = pacientes.filter(p => p.id !== id);
            localStorage.setItem('tcc_pacientes', JSON.stringify(pacientes));

            let sessoes = JSON.parse(localStorage.getItem('tcc_sessoes') || '[]');
            sessoes = sessoes.filter(s => s.pacienteId !== id);
            localStorage.setItem('tcc_sessoes', JSON.stringify(sessoes));

            atualizarListasEPacientes();
        }

        function salvarRegistroSessao() {
            const pacienteId = document.getElementById('sessao-paciente-select').value;
            const data = document.getElementById('sessao-data').value.trim();
            const relato = document.getElementById('sessao-relato').value.trim();

            if (!pacienteId || !relato) {
                alert("Selecione um paciente e insira o relato da sessão.");
                return;
            }

            let sessoes = JSON.parse(localStorage.getItem('tcc_sessoes') || '[]');
            sessoes.push({ id: Date.now().toString(), pacienteId, data, relato });
            localStorage.setItem('tcc_sessoes', JSON.stringify(sessoes));

            document.getElementById('sessao-relato').value = '';
            alert("Sessão registrada com sucesso!");
            atualizarHistoricoHome();
        }

        function atualizarHistoricoHome() {
            let sessoes = JSON.parse(localStorage.getItem('tcc_sessoes') || '[]');
            const pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            const filtroId = document.getElementById('home-filtro-paciente').value;
            const div = document.getElementById('home-historico-lista');

            if (filtroId) {
                sessoes = sessoes.filter(s => s.pacienteId === filtroId);
            }

            document.getElementById('home-historico-qtd').innerText = sessoes.length;

            if (sessoes.length === 0) {
                div.innerHTML = '<p class="text-xs text-slate-400 italic text-center py-2">Nenhuma sessão encontrada.</p>';
                return;
            }

            div.innerHTML = sessoes.slice().reverse().map(s => {
                const p = pacientes.find(item => item.id === s.pacienteId);
                return `
                    <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
                        <div class="flex justify-between items-center font-bold text-slate-700">
                            <span class="text-sm text-indigo-800">${p ? p.nome : 'Paciente'} <span class="text-[10px] text-slate-400 font-normal">(${p ? nomeAbordagemFormatada(p.abordagem) : 'TCC'})</span></span>
                            <span class="text-[10px] bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full">${s.data}</span>
                        </div>
                        
                        <p class="text-xs text-slate-600 leading-snug line-clamp-2" id="resumo-${s.id}">${s.relato}</p>
                        
                        <div class="hidden text-xs text-slate-700 bg-white p-2.5 rounded border border-slate-200 whitespace-pre-wrap" id="detalhe-${s.id}">
                            ${s.relato}
                        </div>

                        <div class="flex justify-between items-center pt-1 border-t border-slate-200/60 text-[11px]">
                            <button onclick="toggleRelatoCompleto('${s.id}')" id="btn-toggle-${s.id}" class="text-indigo-600 font-medium hover:underline">
                                👁️ Ver Relato
                            </button>
                            
                            <div class="flex gap-2">
                                <button onclick="analisarSessaoEspecifica('${s.pacienteId}', '${s.id}')" class="text-emerald-700 font-bold hover:underline">
                                    ⚡ Analisar esta sessão
                                </button>
                                <button onclick="excluirSessao('${s.id}')" class="text-red-500 hover:underline">
                                    🗑️
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleRelatoCompleto(id) {
            const resumo = document.getElementById(`resumo-${id}`);
            const detalhe = document.getElementById(`detalhe-${id}`);
            const btn = document.getElementById(`btn-toggle-${id}`);

            if (detalhe.classList.contains('hidden')) {
                detalhe.classList.remove('hidden');
                resumo.classList.add('hidden');
                btn.innerText = '🙈 Ocultar Relato';
            } else {
                detalhe.classList.add('hidden');
                resumo.classList.remove('hidden');
                btn.innerText = '👁️ Ver Relato';
            }
        }

        function excluirSessao(id) {
            if(!confirm("Tem certeza que deseja apagar este registro de sessão?")) return;
            let sessoes = JSON.parse(localStorage.getItem('tcc_sessoes') || '[]');
            sessoes = sessoes.filter(s => s.id !== id);
            localStorage.setItem('tcc_sessoes', JSON.stringify(sessoes));
            atualizarHistoricoHome();
        }

        function analisarSessaoEspecifica(pacienteId, sessaoId) {
            const sessoes = JSON.parse(localStorage.getItem('tcc_sessoes') || '[]');
            const pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            const sessao = sessoes.find(s => s.id === sessaoId);
            const paciente = pacientes.find(p => p.id === pacienteId);

            if (!sessao) return;

            document.getElementById('supervisor-paciente-select').value = pacienteId;
            if(paciente && paciente.abordagem) {
                document.getElementById('supervisor-abordagem-select').value = paciente.abordagem;
            }
            document.getElementById('supervisor-relato-input').value = `[ANÁLISE FOCAL DE SESSÃO ÚNICA - Data: ${sessao.data}]\n\n${sessao.relato}`;

            const btnSupervisor = document.querySelectorAll('.nav-btn')[3];
            mudarAba('tab-supervisor', btnSupervisor);
        }

        function irParaSupervisorComPaciente(selectId) {
            const id = document.getElementById(selectId).value;
            if(!id) {
                alert("Selecione um paciente primeiro.");
                return;
            }
            document.getElementById('supervisor-paciente-select').value = id;
            carregarContextoGlobalParaSupervisor();
            
            const btnSupervisor = document.querySelectorAll('.nav-btn')[3];
            mudarAba('tab-supervisor', btnSupervisor);
        }

        function carregarContextoGlobalParaSupervisor() {
            const pacienteId = document.getElementById('supervisor-paciente-select').value;
            if (!pacienteId) {
                document.getElementById('supervisor-relato-input').value = '';
                return;
            }

            const pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            const paciente = pacientes.find(p => p.id === pacienteId);
            if(paciente && paciente.abordagem) {
                document.getElementById('supervisor-abordagem-select').value = paciente.abordagem;
            }

            const sessoes = JSON.parse(localStorage.getItem('tcc_sessoes') || '[]');
            const sessoesDoPaciente = sessoes.filter(s => s.pacienteId === pacienteId);

            if (sessoesDoPaciente.length === 0) {
                document.getElementById('supervisor-relato-input').value = 'Nenhuma sessão gravada para este paciente até o momento.';
                return;
            }

            let textoCompilado = `HISTÓRICO CLÍNICO COMPLETO (${sessoesDoPaciente.length} sessão/sessões salvas):\n\n`;
            sessoesDoPaciente.forEach((s, idx) => {
                textoCompilado += `--- SESSÃO ${idx + 1} (${s.data}) ---\n${s.relato}\n\n`;
            });

            document.getElementById('supervisor-relato-input').value = textoCompilado.trim();
        }

        // Função de envio otimizada que consome a Serverless Function com segurança
        async function executarSupervisaoClínica() {
            const relatoGlobal = document.getElementById('supervisor-relato-input').value.trim();
            const pacienteId = document.getElementById('supervisor-paciente-select').value;
            const abordagem = document.getElementById('supervisor-abordagem-select').value;

            if(!relatoGlobal) {
                alert("Selecione um paciente ou digite o relato para análise.");
                return;
            }

            document.getElementById('supervisor-loading').classList.remove('hidden');
            document.getElementById('supervisor-resultado').classList.add('hidden');
            document.getElementById('supervisor-erro-box').classList.add('hidden');

            const pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            const pacienteObj = pacientes.find(p => p.id === pacienteId);

            const textoPromptParaEnviar = `DADOS GERAIS DO PACIENTE:\nNome/Código: ${pacienteObj ? pacienteObj.nome : 'Não identificado'}\nAbordagem Selecionada: ${nomeAbordagemFormatada(abordagem)}\nQueixa Principal: ${pacienteObj ? pacienteObj.queixa : 'N/A'}\nObjetivo Terapêutico: ${pacienteObj ? pacienteObj.objetivo : 'N/A'}\n\nHISTÓRICO CLÍNICO DISPONÍVEL:\n"${relatoGlobal}"`;

            try {
                const response = await fetch('/.netlify/functions/gemini', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        prompt: textoPromptParaEnviar,
                        abordagem: abordagem
                    })
                });

                const data = await response.json();
                document.getElementById('supervisor-loading').classList.add('hidden');

                if (response.ok && data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
                    let texto = data.candidates[0].content.parts[0].text;
                    texto = texto.replace(/```html/g, '').replace(/```/g, '');
                    
                    document.getElementById('supervisor-resposta-conteudo').innerHTML = texto;
                    document.getElementById('supervisor-resultado').classList.remove('hidden');
                } else {
                    document.getElementById('supervisor-erro-detalhe').innerText = data.error || "Erro desconhecido retornado pelo servidor.";
                    document.getElementById('supervisor-erro-box').classList.remove('hidden');
                }
            } catch (e) {
                document.getElementById('supervisor-loading').classList.add('hidden');
                document.getElementById('supervisor-erro-detalhe').innerText = e.message;
                document.getElementById('supervisor-erro-box').classList.remove('hidden');
            }
        }

        function gerarPDFRelatorio() {
            const pacienteId = document.getElementById('supervisor-paciente-select').value;
            const pacientes = JSON.parse(localStorage.getItem('tcc_pacientes') || '[]');
            const paciente = pacientes.find(p => p.id === pacienteId);

            const sessoes = JSON.parse(localStorage.getItem('tcc_sessoes') || '[]');
            const sessoesDoPaciente = sessoes.filter(s => s.pacienteId === pacienteId);

            const abordagem = document.getElementById('supervisor-abordagem-select').value;
            const conteudoAnalise = document.getElementById('supervisor-resposta-conteudo').innerHTML;

            document.getElementById('pdf-data-emissao').innerText = `Emissão: ${new Date().toLocaleDateString('pt-BR')} ${new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'})}`;
            document.getElementById('pdf-paciente-nome').innerText = paciente ? paciente.nome : 'Análise Geral de Caso';
            document.getElementById('pdf-abordagem-nome').innerText = nomeAbordagemFormatada(abordagem);
            document.getElementById('pdf-queixa').innerText = paciente && paciente.queixa ? paciente.queixa : 'Não informada';
            document.getElementById('pdf-objetivo').innerText = paciente && paciente.objetivo ? paciente.objetivo : 'Não informado';

            const historicoDiv = document.getElementById('pdf-historico-sessoes');
            if(sessoesDoPaciente.length === 0) {
                historicoDiv.innerHTML = '<p class="text-slate-500 italic">Nenhum registro individual de sessão cadastrado.</p>';
            } else {
                historicoDiv.innerHTML = sessoesDoPaciente.map((s, idx) => `
                    <div class="p-2.5 bg-slate-50 border border-slate-200 rounded">
                        <p class="font-bold text-slate-800 mb-1">Sessão ${idx + 1} - Data: ${s.data}</p>
                        <p class="text-slate-600 whitespace-pre-wrap">${s.relato}</p>
                    </div>
                `).join('');
            }

            document.getElementById('pdf-conteudo-analise').innerHTML = conteudoAnalise;

            const elemento = document.getElementById('pdf-template');

            const opt = {
                margin:       10,
                filename:     `Prontuario_Relatorio_${paciente ? paciente.nome.replace(/\s+/g, '_') : 'Caso'}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(elemento).save();
        }
    </script>
</body>
</html>
